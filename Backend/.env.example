# Application Settings
APP_NAME=Sovereign Black Ice
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (SQLite local-first)
DATABASE_URL=sqlite:///./data/database.db

# Storage Directories
STORAGE_DIR=./storage
CHROMA_DIR=./storage/chroma
MAX_UPLOAD_SIZE_MB=10

# Local AI / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=all-minilm

# Google Sign-In (OAuth Web Client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Local JWT Application Session Configuration
JWT_SECRET_KEY=change-this-to-a-secure-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cross-Origin Resource Sharing (CORS)
# Supports React Native / Expo web, dev clients, and LAN origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8081","http://localhost:19006"]

